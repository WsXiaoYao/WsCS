# Server Configuration
PORT=5000
NODE_ENV=development

# OpenAI Official API
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Custom OpenAI-Compatible API (第三方OpenAI兼容API)
# 支持GPT、Claude、Gemini等多种模型
CUSTOM_OPENAI_API_KEY=your_custom_api_key_here
CUSTOM_OPENAI_BASE_URL=https://api.example.com/v1  # 替换为实际的API地址
CUSTOM_OPENAI_MODEL=gpt-3.5-turbo  # 可选，默认使用此模型

# CORS
CORS_ORIGIN=http://localhost:3000

# Upload
MAX_FILE_SIZE=10485760
